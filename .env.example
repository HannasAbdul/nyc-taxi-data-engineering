# Snowflake connection
SNOWFLAKE_ACCOUNT=your_snowflake_account
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_WAREHOUSE=NYC_TAX_WH
SNOWFLAKE_DATABASE=NYC_TAXI_DW
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=your_snowflake_role

# Ingestion safety
INGESTION_ALLOW_FIRST_LOAD=false

# Airflow secrets
POSTGRES_PASSWORD=replace_with_a_secure_password
AIRFLOW__API__SECRET_KEY=replace_with_a_secure_secret
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_a_secure_jwt_secret
